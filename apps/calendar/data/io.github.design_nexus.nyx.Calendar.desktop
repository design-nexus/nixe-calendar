[Desktop Entry]
Type=Application
Name=Calendar
GenericName=Calendar
Comment=Your online and local calendars
Exec=nyx-calendar %F
MimeType=text/calendar;application/ics;
Icon=io.github.design_nexus.nyx.Calendar
Terminal=false
Categories=Office;Calendar;GTK;
Keywords=calendar;events;schedule;meeting;agenda;week;
StartupWMClass=io.github.design_nexus.nyx.Calendar
StartupNotify=true
